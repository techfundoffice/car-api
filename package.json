{
  "name": "auto-parts-db",
  "version": "2.1.0",
  "description": "Comprehensive automotive database: 100+ car brands, 2000+ models with generations (1968-present), and 1200+ auto parts. Perfect for dealerships, e-commerce, catalogs, and automotive apps.",
  "keywords": [
    "auto-parts",
    "car-database",
    "car-brands",
    "car-models",
    "car-generations",
    "auto-parts-catalog",
    "automotive-data",
    "vehicle-database",
    "car-catalog",
    "parts-catalog",
    "auto-database",
    "car-parts",
    "auto-brands",
    "vehicle-models",
    "car-years",
    "automotive-api",
    "car-specs",
    "vehicle-specs",
    "auto-catalog",
    "car-parts-api"
  ],
  "homepage": "https://lifeofcapo.github.io/car-api/",
  "bugs": {
    "url": "https://github.com/lifeofcapo/car-list/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifeofcapo/car-list.git"
  },
  "license": "MIT",
  "author": "@lifeofcapo",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./ai": {
      "types": "./dist/types/ai/index.d.ts",
      "import": "./dist/esm/ai/index.js",
      "require": "./dist/cjs/ai/index.js"
    },
    "./mcp": {
      "types": "./dist/types/mcp/server.d.ts",
      "import": "./dist/esm/mcp/server.js",
      "require": "./dist/cjs/mcp/server.js"
    },
    "./embeddings.json": "./embeddings.json",
    "./browser": "./dist/browser/auto-parts-db.min.js"
  },
  "browser": "./dist/browser/auto-parts-db.min.js",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "auto-parts-mcp": "./dist/cjs/mcp/bin.js"
  },
  "files": [
    "dist",
    "embeddings.json"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types && npm run build:browser",
    "build:esm": "tsc --project tsconfig.esm.json && node scripts/write-esm-package-json.mjs",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:types": "tsc --project tsconfig.types.json",
    "prepublishOnly": "npm run build",
    "build:browser": "esbuild src/index.ts --bundle --format=iife --global-name=AutoPartsDB --outfile=dist/browser/auto-parts-db.min.js --minify",
    "build:embeddings": "node scripts/build-embeddings.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "test": "npm run build && npm run verify:packaging && node --test \"test/*.test.js\"",
    "mcp": "node dist/cjs/mcp/bin.js"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.60.0",
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.0.0"
  },
  "module": "./dist/esm/index.js"
}
